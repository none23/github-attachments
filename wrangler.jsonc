{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "github-pr-attachments",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "github-pr-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "QuotaLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaLedger"]
    }
  ],
  "vars": {
    "MAX_STORED_BYTES": "8000000000",
    "MAX_OBJECTS": "50000",
    "MAX_FILE_BYTES": "25000000",
    "MAX_IMAGE_BYTES": "10000000",
    "DAILY_UPLOAD_LIMIT": "1000",
    "MONTHLY_UPLOAD_LIMIT": "100000",
    "RETENTION_DAYS": "180"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    }
  }
}
